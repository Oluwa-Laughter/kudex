# Portaldot V3 organizer endpoints; runtime 3002 verified 2026-10-17.
NEXT_PUBLIC_PORTALDOT_RPC_HTTP=https://test-evm-rpc-v3.portaldot.dev
NEXT_PUBLIC_PORTALDOT_CHAIN_ID=420420777
# Ethereum RPC uses 18 decimals; native Substrate tPOT remains 14 decimals.
NEXT_PUBLIC_PORTALDOT_GAS_DECIMALS=18
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_RFQ_ROUTER_ADDRESS=
NEXT_PUBLIC_DAAS_ADAPTER_ADDRESS=
NEXT_PUBLIC_VERIFIER_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_WPOT_ADDRESS=
NEXT_PUBLIC_WPOT_VAULT_ADDRESS=
NEXT_PUBLIC_RWA_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Foundry configuration. Sign using an encrypted Foundry account or hardware wallet.
PORTALDOT_RPC_HTTP=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_CHAIN_ID=420420777
PORTALDOT_COLLATERAL_ADDRESS=
NEXT_PUBLIC_PORTALDOT_NATIVE_WS=wss://test-node-v3.portaldot.dev
PORTALDOT_NATIVE_WS=wss://test-node-v3.portaldot.dev

# Only enable this for real on-chain, explicitly unbacked KTEST test collateral.
KUDEX_DEPLOY_TEST_ASSET=false

# Optional Gemini conversation. Set both server-only values locally.
GOOGLE_GENERATIVE_AI_API_KEY=
KUDEX_AI_MODEL=gemini-3.8-flash
# Agent infrastructure: populate only after deployment verification.
NEXT_PUBLIC_AGENT_EXECUTOR_ADDRESS=
NEXT_PUBLIC_POLICY_REGISTRY_ADDRESS=
